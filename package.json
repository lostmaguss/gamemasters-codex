{
  "name": "gamemasters-codex",
  "version": "1.33.1",
  "description": "Companion app for game masters: 3D dice, prep, maps, a world wiki and stream overlays, built for Discord games.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:mac": "electron-builder --mac dmg zip"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/oxanium": "^5.3.0",
    "cannon-es": "^0.20.0",
    "discord.js": "^14.16.3",
    "electron-updater": "^6.3.9",
    "qrcode": "^1.5.4",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "productName": "Gamemasters Codex",
  "build": {
    "appId": "com.gamemasters.codex",
    "productName": "Gamemasters Codex",
    "copyright": "Copyright © 2026 lostmaguss. All rights reserved.",
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "LICENSE",
      "preload.js",
      "bot.js",
      "tableserver.js",
      "tunnel.js",
      "notesimport.js",
      "app/**/*",
      "build/icon.png",
      "package.json",
      "node_modules/**/*",
      "!node_modules/three/{examples,src,docs,editor,manual}/**",
      "!node_modules/three/build/three.{cjs,webgpu,tsl}*",
      "!node_modules/cannon-es/{src,examples,docs}/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gamemaster's Codex",
      "artifactName": "GamemastersCodex-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lostmaguss",
        "repo": "gamemasters-codex",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "executableName": "gamemasters-codex",
      "synopsis": "Companion app for game masters",
      "artifactName": "GamemastersCodex-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Gamemaster's Codex",
          "StartupWMClass": "Gamemasters Codex",
          "Keywords": "dice;rpg;dnd;tabletop;discord;"
        }
      }
    },
    "deb": {
      "artifactName": "GamemastersCodex-${version}-${arch}.${ext}",
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    },
    "afterPack": "scripts/after-pack.js",
    "afterSign": "scripts/after-sign.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.role-playing-games",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "GamemastersCodex-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Players' phones connect to the table link on your network."
      }
    },
    "dmg": {
      "title": "Gamemaster's Codex",
      "artifactName": "GamemastersCodex-${version}-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lostmaguss/gamemasters-codex.git"
  },
  "author": {
    "name": "lostmaguss",
    "email": "lostmaguss@users.noreply.github.com"
  },
  "homepage": "https://github.com/lostmaguss/gamemasters-codex"
}
